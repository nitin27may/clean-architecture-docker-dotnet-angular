{
  "name": "contact-portal",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "serve": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:contact-portal": "node dist/contact-portal/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "express": "^5.3.0",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.32",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "ignoredBuiltDependencies": [
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
